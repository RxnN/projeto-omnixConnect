# Use no deploy um usuário de execução sem CREATE ROLE, CREATE DATABASE ou BYPASS RLS.
DATABASE_URL="postgresql://usuario_limitado:senha@host:5432/banco?sslmode=require"
SESSION_SECRET="troque_esta_chave_super_secreta_com_pelo_menos_32_caracteres_para_producao"
RLS_CONTEXT_SECRET="gere_uma_chave_aleatoria_independente_com_32_ou_mais_caracteres"
APP_ORIGIN="https://app.seudominio.com.br"
TRUST_PROXY="false"
DEMO_PASSWORD="defina_uma_senha_local_forte_com_16_ou_mais_caracteres"

# Confirmação de e-mail via Resend. A chave é usada somente no servidor.
RESEND_API_KEY="re_substitua_pela_chave_real"
EMAIL_FROM="Omnix Connect <acesso@seudominio.com.br>"

# Cloudflare Turnstile (login/cadastro). Os valores abaixo são as chaves de TESTE
# públicas da Cloudflare (sempre aprovam) — troque pelas chaves reais do seu site em
# https://dash.cloudflare.com/?to=/:account/turnstile antes de ir pra produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Sentry (monitoramento de erros em produção). Deixe em branco enquanto não criar a
# conta em https://sentry.io — o app funciona normalmente sem isso, só não reporta
# erro nenhum. SENTRY_ORG/PROJECT/AUTH_TOKEN só são usados no build (upload de source
# maps), não precisam existir em ambiente de desenvolvimento.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
