# Use uma branch ou um banco Neon exclusivo para testes. Nunca reutilize a produção.
DATABASE_TEST_URL="postgresql://usuario_limitado_teste:senha@host-de-teste:5432/neondb?sslmode=require"
DATABASE_ADMIN_TEST_URL="postgresql://proprietario_teste:senha@host-de-teste:5432/neondb?sslmode=require"

# Gere uma chave independente da produção, com pelo menos 32 caracteres.
RLS_CONTEXT_TEST_SECRET="gere_uma_chave_aleatoria_exclusiva_para_testes"
